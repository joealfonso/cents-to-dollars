{
  "name": "cents-to-dollars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "track": "node tools/run_ts.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:browser:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
